  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "panels": [
  {
    "id": 1,
    "title": "Position queue size",
    "description": "Current number of tasks waiting in the position request queue.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 7, "w": 9, "x": 0, "y": 0},
    "targets": [
      {
        "refId": "A",
        "expr": "tripgo_position_requests_queue_size{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}",
        "legendFormat": "queue",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 15,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "list", "placement": "bottom", "showLegend": false},
      "tooltip": {"mode": "single", "sort": "none"}
    }
  },
  {
    "id": 2,
    "title": "Active position workers",
    "description": "Current number of workers processing position requests.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 7, "w": 9, "x": 9, "y": 0},
    "targets": [
      {
        "refId": "A",
        "expr": "tripgo_position_requests_workers_active{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}",
        "legendFormat": "active",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 15,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "list", "placement": "bottom", "showLegend": false},
      "tooltip": {"mode": "single", "sort": "none"}
    }
  },
  {
    "id": 7,
    "title": "Positions saved — selected range",
    "description": "Number of coordinates saved during the time range selected in the dashboard.",
    "type": "stat",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
    "targets": [
      {
        "refId": "A",
        "expr": "round(sum(increase(tripgo_positions_saved_total{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__range])))",
        "legendFormat": "saved",
        "instant": true,
        "range": false
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
      },
      "overrides": []
    },
    "options": {
      "colorMode": "value",
      "graphMode": "area",
      "justifyMode": "auto",
      "orientation": "auto",
      "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
      "textMode": "auto",
      "wideLayout": true
    }
  },
  {
    "id": 3,
    "title": "Stale checks rate by result",
    "description": "Scanner decisions per second. A growing dropped rate means that the queue cannot accept all tasks.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
    "targets": [
      {
        "refId": "A",
        "expr": "sum by (result) (rate(tripgo_stale_checks_total{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__rate_interval]))",
        "legendFormat": "{{result}}",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "ops",
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 10,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
      "tooltip": {"mode": "multi", "sort": "desc"}
    }
  },
  {
    "id": 4,
    "title": "Stale checks — selected range",
    "description": "Scanner decisions accumulated only during the time range selected in the dashboard.",
    "type": "bargauge",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
    "targets": [
      {
        "refId": "A",
        "expr": "(round(sum by (result) (increase(tripgo_stale_checks_total{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__range])))) or label_replace(vector(0), \"result\", \"queued\", \"\", \".*\") or label_replace(vector(0), \"result\", \"duplicate\", \"\", \".*\") or label_replace(vector(0), \"result\", \"dropped\", \"\", \".*\")",
        "legendFormat": "{{result}}",
        "instant": true,
        "range": false
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "palette-classic"}
      },
      "overrides": []
    },
    "options": {
      "displayMode": "gradient",
      "orientation": "vertical",
      "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true},
      "showUnfilled": true,
      "sizing": "auto",
      "valueMode": "color"
    }
  },
  {
    "id": 5,
    "title": "Position request rate by result",
    "description": "Position request outcomes per second. Dropped means a task could not be kept in the full queue.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
    "targets": [
      {
        "refId": "A",
        "expr": "sum by (result) (rate(tripgo_position_requests_total{job=\"otel-collector\", exported_job=\"tripgo/trip-service\", result=~\"success|error|dropped\"}[$__rate_interval]))",
        "legendFormat": "{{result}}",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 10,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
      "tooltip": {"mode": "multi", "sort": "desc"}
    }
  },
  {
    "id": 6,
    "title": "Position request results — selected range",
    "description": "Position request outcomes accumulated only during the selected range.",
    "type": "bargauge",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
    "targets": [
      {
        "refId": "A",
        "expr": "(round(sum by (result) (increase(tripgo_position_requests_total{job=\"otel-collector\", exported_job=\"tripgo/trip-service\", result=~\"success|error|dropped\"}[$__range])))) or label_replace(vector(0), \"result\", \"success\", \"\", \".*\") or label_replace(vector(0), \"result\", \"error\", \"\", \".*\") or label_replace(vector(0), \"result\", \"dropped\", \"\", \".*\")",
        "legendFormat": "{{result}}",
        "instant": true,
        "range": false
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "palette-classic"}
      },
      "overrides": []
    },
    "options": {
      "displayMode": "gradient",
      "orientation": "vertical",
      "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true},
      "showUnfilled": true,
      "sizing": "auto",
      "valueMode": "color"
    }
  },
  {
    "id": 8,
    "title": "Push Service request duration",
    "description": "p95 and p99 duration of completed Push Service calls, split by result.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
    "targets": [
      {
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, result) (rate(tripgo_position_requests_duration_seconds_bucket{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__rate_interval])))",
        "legendFormat": "p95 {{result}}",
        "range": true
      },
      {
        "refId": "B",
        "expr": "histogram_quantile(0.99, sum by (le, result) (rate(tripgo_position_requests_duration_seconds_bucket{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__rate_interval])))",
        "legendFormat": "p99 {{result}}",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "s",
        "decimals": 3,
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 10,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
      "tooltip": {"mode": "multi", "sort": "desc"}
    }
  },
  {
    "id": 9,
    "title": "Rows read per stale scan — p95",
    "description": "p95 number of rows read by one scanner tick. This panel covers the batched-selection extension.",
    "type": "timeseries",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
    "targets": [
      {
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(tripgo_stale_checks_rows_read_bucket{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__rate_interval])))",
        "legendFormat": "p95 rows",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "short",
        "decimals": 0,
        "min": 0,
        "color": {"mode": "palette-classic"},
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "fillOpacity": 10,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {"mode": "none", "group": "A"}
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
      "tooltip": {"mode": "single", "sort": "none"}
    }
  },
  {
    "id": 10,
    "title": "Push Service request duration distribution",
    "description": "Push Service request duration buckets over time. Color shows the request rate for each duration range.",
    "type": "heatmap",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
    "targets": [
      {
        "refId": "A",
        "expr": "sum by (le) (rate(tripgo_position_requests_duration_seconds_bucket{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__rate_interval]))",
        "format": "heatmap",
        "instant": false,
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "min": 0,
        "custom": {
          "hideFrom": {"legend": false, "tooltip": false, "viz": false},
          "scaleDistribution": {"type": "linear"}
        }
      },
      "overrides": []
    },
    "options": {
      "calculate": false,
      "cellGap": 1,
      "color": {
        "exponent": 0.5,
        "fill": "dark-red",
        "mode": "scheme",
        "reverse": true,
        "scale": "linear",
        "scheme": "Reds",
        "steps": 64
      },
      "filterValues": {"le": 1e-9},
      "legend": {"placement": "bottom", "show": true},
      "rowsFrame": {"layout": "auto"},
      "tooltip": {"mode": "single", "yHistogram": false},
      "yAxis": {"axisPlacement": "left", "reverse": false}
    }
  }

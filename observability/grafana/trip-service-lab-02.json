  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests — selected range",
      "description": "Completed HTTP requests during the time range selected in the dashboard.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(http_server_request_duration_seconds_count{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {"mode": "fixed", "fixedColor": "blue"}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx — selected range",
      "description": "Server errors during the selected time range. Client 4xx responses are shown separately below.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(http_server_request_duration_seconds_count{job=\"otel-collector\", exported_job=\"tripgo/trip-service\", http_response_status_code=~\"5..\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      }

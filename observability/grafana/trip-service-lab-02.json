      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 5},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (http_server_active_requests{job=\"otel-collector\", exported_job=\"tripgo/trip-service\"})",

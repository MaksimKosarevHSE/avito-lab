    {
      "id": 10,
      "title": "HTTP response rate by status",
      "description": "Completed requests per second grouped by HTTP status code. 4xx are client or business errors; 5xx are service errors.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
